# .env.librechat.example
# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for docker-compose.librechat.yml
#
# Copy this file to .env.librechat and fill in your values.
# Do NOT commit .env.librechat to version control.
#
# Per-user credentials (email + API token) are NOT configured here.
# They are entered by each LibreChat user through the UI and sent per-request
# as X-Atlassian-Email / X-Atlassian-Token headers.
#
# See docs/readme_cloud_apikey.md for the full setup guide.
# ─────────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════════════
# ENVIRONMENT 1 — Primary Atlassian Cloud instance
# ══════════════════════════════════════════════════════════════════════════════

# Required: base URLs for your first Atlassian Cloud instance (no trailing slash)
JIRA_URL_ENV1=https://your-company.atlassian.net
CONFLUENCE_URL_ENV1=https://your-company.atlassian.net/wiki

# Optional: service-account credentials used as a global fallback when a
# request arrives without X-Atlassian-Email / X-Atlassian-Token headers.
# Per-user headers always override these.
# Leave blank to require per-user headers for all requests.
JIRA_SERVICE_ACCOUNT_EMAIL_ENV1=mcp-bot@your-company.com
JIRA_SERVICE_ACCOUNT_TOKEN_ENV1=your_service_account_api_token_here
CONFLUENCE_SERVICE_ACCOUNT_EMAIL_ENV1=mcp-bot@your-company.com
CONFLUENCE_SERVICE_ACCOUNT_TOKEN_ENV1=your_service_account_api_token_here

# ══════════════════════════════════════════════════════════════════════════════
# ENVIRONMENT 2 — Secondary Atlassian Cloud instance
# ══════════════════════════════════════════════════════════════════════════════

# Required: base URLs for your second Atlassian Cloud instance (no trailing slash)
JIRA_URL_ENV2=https://your-other-company.atlassian.net
CONFLUENCE_URL_ENV2=https://your-other-company.atlassian.net/wiki

JIRA_SERVICE_ACCOUNT_EMAIL_ENV2=mcp-bot@other-company.com
JIRA_SERVICE_ACCOUNT_TOKEN_ENV2=your_service_account_api_token_here
CONFLUENCE_SERVICE_ACCOUNT_EMAIL_ENV2=mcp-bot@other-company.com
CONFLUENCE_SERVICE_ACCOUNT_TOKEN_ENV2=your_service_account_api_token_here

# ══════════════════════════════════════════════════════════════════════════════
# LOGGING (applies to both containers)
# ══════════════════════════════════════════════════════════════════════════════

# Set to true for INFO-level logs, MCP_VERY_VERBOSE=true for DEBUG-level logs
MCP_VERBOSE=false
MCP_VERY_VERBOSE=false
